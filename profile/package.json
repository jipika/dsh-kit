    "@michengai/dsh-archive-manager": "1.0.5",
    "@noob-stupid/dsh-plugin-console": "github:jipika/dsh-plugin-console",
    "dsh-better-sidebar": "0.21.1",
    "dsh-claude-theme": "github:jipika/dsh-claude-theme",
    "dsh-code-nav": "github:AnakinCao/dsh-code-nav",
    "dsh-computer-use-compat": "github:jipika/dsh-computer-use-compat",
    "dsh-config-manager": "0.1.64",
    "dsh-context": "^0.57.0",
    "dsh-drag-and-drop": "^0.1.6",
    "dsh-ego-browser": "git+https://github.com/Fisfzy/ego-browser.git",
    "dsh-github": "0.1.0",
    "dsh-infinite-gen-4": "github:jipika/dsh-infinite-gen-4",
    "dsh-lan-loopback-compat": "github:jipika/dsh-lan-loopback-compat",
    "dsh-memguard": "github:jipika/dsh-memguard",
    "dsh-plugin-github-code-theme": "github:jipika/dsh-plugin-github-code-theme",
    "dsh-plugin-polish": "github:jipika/dsh-plugin-polish",
    "dsh-plugin-save-token": "^2.4.1",
    "dsh-rewind-plugin": "0.14.0-beta.2",
    "dsh-skill-mcp-panel": "github:jipika/dsh-skill-mcp-panel",
    "dsh-smooth-cursor": "^0.1.9",
    "dsh-smooth-stream": "^0.6.1",
    "dsh-todo-float": "github:jipika/dsh-todo-float",
    "dsh-ui-fixes": "github:jipika/dsh-ui-fixes",
    "dsh-ui-harmonizer": "^0.8.3",
    "dsh-video-preview": "^0.1.4",
    "dsh-web-low-motion": "^0.4.5",
    "dshmarket": "^1.66.2",
    "dsh-proxy-autoswitch": "github:jipika/dsh-proxy-autoswitch"
  },
  "scripts": {
    "postinstall": "node -e \"const f='node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper';try{require('node:fs').chmodSync(f,0o755);console.log('spawn-helper +x ok')}catch(e){console.log('spawn-helper chmod skipped:',e.code)}\" && node scripts/patch-harmonizer.cjs && node scripts/patch-context-units.cjs && node scripts/patch-context-balance.cjs && node scripts/patch-smooth-stream-icons.cjs && node scripts/patch-ego-browser-no-autotab.cjs"
  },
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app",
        "@liustack/modsearch",
        "dsh-better-sidebar",
        "dsh-context",
        "@noob-stupid/dsh-plugin-console",
        "dsh-github",
        "dsh-skill-mcp-panel",
        "@michengai/dsh-archive-manager",
        "dsh-smooth-cursor",
        "@jipika/dsh-think-ux",
        "dsh-plugin-save-token",
        "dsh-config-manager",
        "dsh-ego-browser",
        "dsh-video-preview",
        "dsh-web-low-motion",
        "dsh-code-nav",
        "dsh-drag-and-drop",
        "@jipika/dsh-memory",
        "dsh-infinite-gen-4",
        "dsh-rewind-plugin",
        "@dhicoc/dsh-reverse-skill",
        "@deepseek-ai/dsh-experimental-agent-team-profile",
        "dsh-plugin-github-code-theme",
        "dsh-plugin-polish",
        "dsh-ui-fixes",
        "dsh-ui-harmonizer",
        "dsh-smooth-stream",
        "dshmarket"
      ],
      "patchReload": "live"
    }
  }
}
